# 运行参数（与合约分离：改这里不影响数据契约）
dataset: {{name}}

ingest:
  enabled: {{has_ingest}}
  source_id: "{{source_id}}"      # 对应 data_contracts/external_sources.yaml
  skip_if_fingerprint_match: true # raw manifest 命中即跳过下载（多 dataset 共享 source 时省带宽）
  # 增量抓取的边界策略 —— 必须三选一并删掉其余两个，不能是 null/不设：
  #   ndays: 20            # 按最近 N 个自然/工作日回看（范例：polygon__stk_eod）
  #   lookback_days: 45    # 按日期窗口过滤候选，date >= today - N（范例：sec__filing_text）
  #   max_records: TODO    # 分页硬上限，配合 dwlib.http.paginate(max_records=...)（范例：polygon__stk_dividend）
  # 三者都不适用（数据源天生就小，一次全量几秒内拉完）时，在这里写清楚原因，
  # 并仍然给 max_records 一个显式小整数兜底，不要留 null。

transform:
  enabled: {{has_transform}}
  mode: standard                  # standard | passthrough
  write_mode: overwrite           # overwrite | append
  partition_by: []

runtime:
  # 本 dataset 单个阶段允许的进程峰值内存（GB）。**新建时必须估算并经用户确认**，
  # 不是随手填的 —— 全仓上限见 warehouse.yaml 的 engine.memory_budget_gb。
  # dw run 每次实测，超申报值 25% 会告警（多半是数据涨了，或写法退化成整表物化）。
  # 撑不住预算时的标准手段：build() 返回 LazyFrame 让 write_curated 流式落盘；
  # 还不够就按分区切块，用 dw.write_curated_chunks 逐块喂。
  memory_estimate_gb: 1.0
  timeout_seconds: 1800
  retries: 2
